rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      // Any user can read donor profiles to find help
      allow read: if true;
      // Authenticated users can create or update their profile
      allow write: if isAuthenticated();
    }

    match /bloodRequests/{requestId} {
      // Anyone can read blood requests to donate
      allow read: if true;
      // Anyone can create or respond to emergency blood requests
      allow create, update: if true;
      // Deletion only for authenticated users
      allow delete: if isAuthenticated();
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

